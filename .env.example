# GEMINI_API_KEY: Required for server-side Gemini 3.8 Flash model execution.
# AI Studio automatically injects this at runtime from user secrets.
# Cloud Run: Bind this from Secret Manager via --set-secrets="GEMINI_API_KEY=gemini-api-key:latest"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: The port the HTTP server listens on (defaults to 3000 in dev; Cloud Run injects 8080/PORT)
PORT=3000

# NODE_ENV: Set to 'production' for compiled asset serving and stack-trace suppression
NODE_ENV=development

# APP_URL: The public URL where this applet is hosted
APP_URL="http://localhost:3000"

# Optional Cloud Firestore configuration for persistent multi-user incident storage.
# If omitted or unconfigured, SignalBridge AI automatically falls back to the in-memory
# repository with an explicit [In-Memory Demo] status indicator.
FIREBASE_PROJECT_ID=""
GOOGLE_APPLICATION_CREDENTIALS=""
